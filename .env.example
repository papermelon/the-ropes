# Server only. Never use VITE_ prefixes for provider secrets.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Restricted key: Speech to Text Access, ElevenAgents Write (signed sessions require convai_write).
ELEVENLABS_API_KEY=
# Agent menu (three dots beside its name) -> Agent ID; not the API Key ID.
ELEVENLABS_AGENT_ID=
# Required explicit human approval, then local opt-in; never enables live automatically.
LIVE_USAGE_APPROVED=false
# Total approved lifetime cap, including the preserved US$1.80 historical used/held.
# US$3 is the existing approval; a higher value requires explicit user approval.
PROVIDER_TOTAL_CAP_USD=3
# Legacy remaining-only cap. Leave blank when TOTAL is configured; never use as a fresh allowance.
PROVIDER_USAGE_CAP_USD=
# Conservative bounds, not a provider billing guarantee. Also set provider account limits.
MAX_LIVE_REQUESTS=8
MAX_LIVE_VOICE_SECONDS=120
PORT=8787
HOST=127.0.0.1
# Private local ledger is ignored by Git. Public hosting must use an absolute persistent-disk path.
BUDGET_LEDGER_PATH=
# First boot needs deliberate initialization (true), then false after the ledger exists.
# Restore the retained ledger instead of initializing if any new spend has occurred.
BUDGET_INITIALIZE_ALLOWED=false
LIVE_USAGE_DISABLED=false
# Optional immediate disk kill switch: create this file to block new paid calls, then remove to resume.
BUDGET_KILL_SWITCH_PATH=
MAX_LIVE_CONCURRENCY=1
MAX_API_REQUESTS_PER_MINUTE=60
# Public access remains off until deployment approval. HTTPS reverse proxy required.
PUBLIC_DEMO=false
ALLOWED_HOSTS=
ALLOWED_ORIGINS=
# Public demo uses browser Basic auth. Create/enter these only in the provider's secret settings.
DEMO_ACCESS_USER=
DEMO_ACCESS_PASSWORD=
